{
  "name": "mister-no-prices",
  "version": "1.8.2",
  "private": true,
  "description": "Extension Firefox qui masque les prix sur Amazon, les grandes boutiques, les sites de petites annonces et d’occasion, et Google.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "web-ext run --source-dir extension --start-url https://www.amazon.fr",
    "lint": "web-ext lint --source-dir extension",
    "build": "web-ext build --source-dir extension --artifacts-dir web-ext-artifacts --filename \"mister-no-prices-{version}.zip\" --overwrite-dest",
    "paquet": "node scripts/paquet.mjs",
    "test": "node --test",
    "verifier": "node scripts/verifier.mjs",
    "verifier:mise-a-jour": "node scripts/verifier-mise-a-jour.mjs",
    "catalogue": "node scripts/catalogue.mjs",
    "manifeste": "node scripts/manifeste.mjs",
    "lint:js": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "puppeteer-core": "^25.18.1",
    "web-ext": "^10.8.0"
  }
}
